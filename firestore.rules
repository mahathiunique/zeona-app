rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify if user is accessing their own user space
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Global achievements: read-only for authenticated clients, write denied
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Scopes all user profiles and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Recursively locks down all subcollections (tasks, habits, journals, etc.)
      match /{subcollection}/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
